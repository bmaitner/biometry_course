  <previewCommands>setup repeat 60 [ go ]</previewCommands>
  <experiments>
    <experiment name="verify" repetitions="5" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="5000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>placed</metric>
        <metric>mean-count</metric>
        <metric>var-to-mean</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="mechanism"><value value="&quot;clumped&quot;"></value><value value="&quot;variable habitat&quot;"></value></enumeratedValueSet>
        <enumeratedValueSet variable="covey-size"><value value="1"></value><value value="12"></value></enumeratedValueSet>
        <enumeratedValueSet variable="habitat-variation"><value value="0"></value><value value="1"></value></enumeratedValueSet>
        <enumeratedValueSet variable="mean-per-quadrat"><value value="3"></value></enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
