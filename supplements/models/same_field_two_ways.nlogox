<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;; The same field, two ways
;;
;; Birds land on a 20 x 20 field of quadrats, and we count how many end up in
;; each quadrat. Two different biological reasons can make those counts
;; clumped, and this model lets you watch each one happen.
;;
;;   clumped           birds arrive in coveys, and a covey lands together
;;   variable habitat  birds arrive one at a time, but some quadrats are
;;                     better habitat and attract more of them
;;
;; Set covey size to 1, or habitat variation to 0, and every bird lands
;; independently and uniformly: the counts become Poisson.

globals [
  total-birds    ;; how many birds will land in this run
  placed         ;; how many have landed so far
  max-quality    ;; best habitat in the field, used to choose landing spots
]

patches-own [
  birds          ;; birds counted in this quadrat
  quality        ;; how attractive this quadrat is (variable habitat only)
]

breed [ quail a-quail ]

to setup
  clear-all
  set total-birds round (mean-per-quadrat * count patches)
  set placed 0
  ask patches [
    set birds 0
    ;; quality has mean 1; habitat-variation is its coefficient of variation
    ifelse habitat-variation > 0
      [ let a 1 / (habitat-variation ^ 2)
        set quality random-gamma a a ]
      [ set quality 1 ]
  ]
  set max-quality max [quality] of patches
  recolor
  draw-histogram
  reset-ticks
end

to go
  if placed >= total-birds [ stop ]
  ifelse mechanism = "clumped"
    [ drop-covey ]
    [ repeat 10 [ if placed < total-birds [ drop-by-habitat ] ] ]
  recolor
  draw-histogram
  tick
end

;; A covey picks one spot at random and lands there together, scattered a
;; little around the spot.
to drop-covey
  let cx random-xcor
  let cy random-ycor
  let n min (list covey-size (total-birds - placed))
  create-quail n [
    setxy cx cy
    rt random 360
    fd abs random-normal 0 0.35
    land
  ]
end

;; A single bird picks a quadrat, favoring good habitat. A random quadrat is
;; accepted with probability proportional to its quality, which needs no
;; extensions and so also runs in NetLogo Web.
to drop-by-habitat
  let target nobody
  while [ target = nobody ] [
    let candidate one-of patches
    if random-float max-quality < [quality] of candidate [ set target candidate ]
  ]
  create-quail 1 [
    move-to target
    setxy (xcor + random-float 0.9 - 0.45) (ycor + random-float 0.9 - 0.45)
    land
  ]
end

to land  ;; turtle procedure
  set shape "bird side"
  set size 0.6
  set color bird-color
  set birds birds + 1
  set placed placed + 1
end

;; tan, for a bobwhite. One place to change it.
to-report bird-color
  report brown + 2
end

to recolor
  let top max list 1 (max [birds] of patches)
  ask patches [ set pcolor scale-color green birds 0 top ]
end

;; The observed histogram, with what a Poisson and a negative binomial with
;; the same mean would predict. Both curves are built by recursion, so no
;; gamma function and no extensions are needed.
to draw-histogram
  set-current-plot "birds per quadrat"
  let top max [birds] of patches + 2
  set-plot-x-range 0 top

  set-current-plot-pen "observed"
  histogram [birds] of patches

  let m mean-count
  let v variance-count
  let n count patches

  set-current-plot-pen "Poisson"
  plot-pen-reset
  if m > 0 [
    let p exp (- m)
    let k 0
    repeat top [
      plotxy (k + 0.5) (p * n)
      set p p * m / (k + 1)
      set k k + 1
    ]
  ]

  set-current-plot-pen "negative binomial"
  plot-pen-reset
  if m > 0 and v > m [
    let s (m ^ 2) / (v - m)
    let p (s / (s + m)) ^ s
    let k 0
    repeat top [
      plotxy (k + 0.5) (p * n)
      set p p * ((k + s) / (k + 1)) * (m / (s + m))
      set k k + 1
    ]
  ]
end

to-report mean-count
  report mean [birds] of patches
end

to-report variance-count
  report variance [birds] of patches
end

to-report var-to-mean
  ifelse mean-count > 0
    [ report variance-count / mean-count ]
    [ report 0 ]
end

;; The negative binomial's size parameter, by the method of moments.
;; Small values mean strong clumping; it grows without limit as the counts
;; approach a Poisson.
to-report fitted-size
  let m mean-count
  let v variance-count
  ifelse v > m
    [ report precision ((m ^ 2) / (v - m)) 2 ]
    [ report "very large (Poisson)" ]
end
]]></code>
